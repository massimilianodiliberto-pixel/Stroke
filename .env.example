# Database (SQLite locale — zero configurazione)
DATABASE_URL="file:./dev.db"

# Sessione admin (min 32 caratteri casuali)
SESSION_SECRET="cambia-questo-segreto-con-32-caratteri-minimo"

# Credenziali area admin (/admin)
ADMIN_USER="stroke"
ADMIN_PASSWORD="cambiami"

# URL pubblico del sito (per sitemap, OG, redirect Stripe)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe — finché è false gli ordini funzionano in modalità "prenotazione
# senza pagamento": il negozio contatta il cliente per confermare.
STRIPE_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email ordini (Resend) — opzionale
EMAIL_ENABLED="false"
RESEND_API_KEY=""
EMAIL_FROM="Stroke Shop <ordini@strokeshop.it>"
SHOP_NOTIFICATION_EMAIL=""
