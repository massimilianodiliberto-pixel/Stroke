// Stroke Shop — modello dati
// SQLite in dev; il provider si può cambiare in Postgres/libSQL senza toccare il resto.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  nameIt   String
  nameEn   String
  products Product[]
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Season {
  SUMMER
  WINTER
  ALL
}

model Product {
  id                 String         @id @default(cuid())
  slug               String         @unique
  name               String
  brandId            String
  brand              Brand          @relation(fields: [brandId], references: [id])
  categoryId         String?
  category           Category?      @relation(fields: [categoryId], references: [id])
  descriptionIt      String?
  descriptionEn      String?
  priceCents         Int
  // Dato interno (prezzo d'acquisto): mai esposto nelle query pubbliche.
  purchasePriceCents Int?
  vatRate            Int            @default(22)
  season             Season         @default(ALL)
  year               Int?
  status             ProductStatus  @default(DRAFT)
  featured           Boolean        @default(false)
  // Chiave di aggancio per l'import Excel: slug(brand)::slug(nome)
  importKey          String?        @unique
  // Quantità grezza dell'ultimo import Excel (informativa, non è lo stock vendibile)
  excelQty           Int?
  images             ProductImage[]
  variants           ProductVariant[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, brandId, categoryId, season])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  quantity   Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, size])
}

enum OrderStatus {
  AWAITING_PAYMENT
  PENDING_REVIEW
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentMode {
  STRIPE
  MANUAL
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  status                OrderStatus
  paymentMode           PaymentMode
  customerName          String
  email                 String
  phone                 String?
  shippingLine1         String?
  shippingCity          String?
  shippingZip           String?
  shippingCountry       String      @default("IT")
  pickupInStore         Boolean     @default(false)
  locale                String      @default("it")
  totalCents            Int
  customerNote          String?
  adminNote             String?
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status, createdAt])
}

// Snapshot del prodotto al momento dell'ordine: sopravvive a modifiche e cancellazioni.
model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  brandName   String
  size        String
  priceCents  Int
  imageUrl    String?
  quantity    Int             @default(1)
}

enum ImportStatus {
  PREVIEW
  APPLIED
  DISCARDED
}

model ImportSession {
  id        String       @id @default(cuid())
  filename  String
  status    ImportStatus @default(PREVIEW)
  payload   String
  summary   String?
  createdAt DateTime     @default(now())
  appliedAt DateTime?
}
